#!/bin/sh
set -eu

PORT="${1:-8787}"
CONF_PATH="/etc/filebrowser-q/config.yaml"
DB_PATH="/etc/filebrowser-q/database.sqlite"
MARKER="/etc/filebrowser-q/.admin-password-initialized"

if [ -f "$MARKER" ] && [ -s "$DB_PATH" ]; then
    exit 0
fi

rm -f "$MARKER"
attempt=0
while [ "$attempt" -lt 300 ]; do
    if wget -q -T 2 -O /dev/null "http://127.0.0.1:$PORT/health"; then
        /usr/bin/filebrowser-q user set admin --password admin -c "$CONF_PATH"
        sed -i '/^[[:space:]]*migrateFrom:/d' "$CONF_PATH"
        touch "$MARKER"
        exit 0
    fi

    sleep 1
    attempt=$((attempt + 1))
done

exit 1
