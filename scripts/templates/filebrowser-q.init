#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99

CONF="filebrowser-q"
PROG="/usr/bin/filebrowser-q"
CONF_PATH="/etc/filebrowser-q/config.yaml"
DB_PATH="/etc/filebrowser-q/database.sqlite"
LEGACY_DB_PATH="/etc/filebrowser-q/database.db"

start_service() {
    config_load "$CONF"

    local enabled listen_port root_path migrate_from
    config_get_bool enabled "config" "enabled" "1"
    [ "$enabled" -eq "1" ] || return 1

    config_get listen_port "config" "listen_port" "8787"
    config_get root_path "config" "root_path" "/"

    # v2.0 moved HTTP settings to the top-level http section and the
    # database to SQLite. Preserve the old YAML before regenerating it.
    if [ -f "$CONF_PATH" ] && ! grep -q "^http:" "$CONF_PATH"; then
        cp -p "$CONF_PATH" "$CONF_PATH.legacy"
        rm -f "$CONF_PATH"
    fi

    if [ ! -f "$CONF_PATH" ]; then
        mkdir -p "$(dirname "$CONF_PATH")"

        if [ -s "$LEGACY_DB_PATH" ]; then
            migrate_from="      migrateFrom: \"$LEGACY_DB_PATH\""
        fi

        cat <<EOF > "$CONF_PATH"
http:
  port: $listen_port
  listen: "0.0.0.0"
  baseURL: "/"
server:
  database:
    path: "$DB_PATH"
$migrate_from
  sources:
    - name: "root"
      path: "$root_path"
      config:
        defaultEnabled: true
        defaultPermissions:
          view: true
          download: true
          modify: true
          create: true
          delete: true
auth:
  adminUsername: "admin"
  methods:
    password:
      enabled: true
userDefaults:
  ui:
    locale: "zhCN"
EOF
        chmod 600 "$CONF_PATH"
    else
        sed -i \
            -e "s/^  port:.*/  port: $listen_port/" \
            -e "s#^      path: .*#      path: \"$root_path\"#" \
            "$CONF_PATH"
    fi

    # Let the one-shot bootstrap set the default credential in SQLite; a
    # config-level adminPassword would be regenerated/reset on service starts.
    sed -i '/^[[:space:]]*adminPassword:/d' "$CONF_PATH"

    procd_open_instance
    procd_set_param command "$PROG" -c "$CONF_PATH"
    procd_set_param limits core="unlimited"
    procd_set_param limits nofile="1000000 1000000"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn
    procd_close_instance

    procd_open_instance bootstrap
    procd_set_param command /usr/libexec/filebrowser-q-bootstrap "$listen_port"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "$CONF"
}
