#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

start_service() {
	[ -x /usr/bin/filebrowser-quantum ] || return 1

	procd_open_instance
	procd_set_param command /usr/bin/filebrowser-quantum -c /etc/filebrowser-quantum/config.yaml
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
